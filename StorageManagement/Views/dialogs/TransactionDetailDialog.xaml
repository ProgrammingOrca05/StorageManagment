<Window x:Class="StorageManagement.Views.dialogs.TransactionDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transaction Details"
        Height="450"
        Width="500"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Segoe UI"
        Icon="/Assets/icons/trans.ico">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#EFF6FF"
                CornerRadius="12"
                Padding="12"
                Grid.Row="0"
                Margin="0,0,0,12">

            <StackPanel>
                <TextBlock FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1E3A8A"
                           Text="{Binding Id, StringFormat='Transaction #{0}'}"/>

                <TextBlock Text="{Binding Date}"
                           Margin="0,5,0,0"/>

                
            </StackPanel>

        </Border>

        <Border Grid.Row="1"
                CornerRadius="12"
                BorderBrush="#BFDBFE"
                BorderThickness="1">

            <DataGrid ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      AlternatingRowBackground="#EFF6FF">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2563EB"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding Product.Name}"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding Product.Price, StringFormat={}{0:F2} EGP}"/>
                    <DataGridTextColumn Header="Line Total" Binding="{Binding TotalPrice, StringFormat={}{0:F2} EGP}"/>
                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Background="#DBEAFE"
                CornerRadius="10"
                Padding="10">

            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="{Binding Subtotal, StringFormat='Subtotal: {0:F2} EGP'}"/>
                <TextBlock Text="{Binding VAT,      StringFormat='VAT (14%): {0:F2} EGP'}"/>
                <TextBlock Text="{Binding Total,    StringFormat='Total: {0:F2} EGP'}"
                                                    FontWeight="Bold"
                                                    FontSize="15"
                                                    Foreground="#1E3A8A"/>
            </StackPanel>

        </Border>

    </Grid>
</Window>