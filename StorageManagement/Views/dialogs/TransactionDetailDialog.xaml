<Window x:Class="StorageManagement.Views.dialogs.TransactionDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transaction Details"
        Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Id, StringFormat='Transaction #{0}'}"/>
            <TextBlock Text="{Binding Date}" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding PaymentMethod}" Margin="0,5,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Product"    Binding="{Binding ProductName}"/>
                <DataGridTextColumn Header="Quantity"   Binding="{Binding Quantity}"/>
                <DataGridTextColumn Header="Price"      Binding="{Binding Price}"/>
                <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right">
            <TextBlock Text="{Binding Subtotal, StringFormat='Subtotal: {0:C}'}"/>
            <TextBlock Text="{Binding Tax, StringFormat='Tax: {0:C}'}"/>
            <TextBlock Text="{Binding Total, StringFormat='Total: {0:C}'}" FontWeight="Bold" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>