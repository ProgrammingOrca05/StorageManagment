<UserControl x:Class="StorageManagement.Views.userControls.SalesTerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- ═══ Blue action button with rounded corners ═══ -->
        <Style x:Key="BlueButton" TargetType="Button">
            <Setter Property="Background" Value="#2B8BEB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16 9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A6FC4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#155A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#B0C4DE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Rounded search text box ═══ -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10 0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#85C7E8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ Page Title ══════════════ -->
        <TextBlock Grid.Row="0"
                   Text="Sales Terminal"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#1A3A4A"
                   Margin="0 0 0 16">
            <TextBlock.Effect>
                <DropShadowEffect Color="#BBCCDD" BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- ══════════════ Two-column content layout ══════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ════════ LEFT PANEL: Product Search ════════ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Section header -->
                <Border Grid.Row="0"
                        Background="#2B8BEB"
                        CornerRadius="8"
                        Padding="12 8"
                        Margin="0 0 0 8">
                    <TextBlock Text="🔍  Product Search"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"/>
                </Border>

                <!-- Search box bound to SearchQuery -->
                <TextBox Grid.Row="1"
                         Style="{StaticResource RoundedTextBox}"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0 0 0 8"/>

                <!-- Search results list bound to SearchResults -->
                <ListView Grid.Row="2"
                          ItemsSource="{Binding SearchResults}"
                          SelectedItem="{Binding SelectedProduct}"
                          BorderBrush="#85C7E8"
                          BorderThickness="1"
                          Margin="0 0 0 8">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name"  DisplayMemberBinding="{Binding Name}"     Width="140"/>
                            <GridViewColumn Header="SKU"   DisplayMemberBinding="{Binding Id}"       Width="55"/>
                            <GridViewColumn Header="Price" DisplayMemberBinding="{Binding Price,  StringFormat={}{0:F2} EGP}" Width="90"/>
                            <GridViewColumn Header="Stock" DisplayMemberBinding="{Binding Quantity}" Width="55"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Add to cart button fires AddToCartCommand -->
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <Button Content="＋  Add to Cart"
                                Style="{StaticResource BlueButton}"
                                Command="{Binding AddToCartCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0 0 8 0"/>
                    <Button Content="📷  Scan"
                                Style="{StaticResource BlueButton}"
                                Background="#4A90D9"
                                Command="{Binding OpenCameraCommand}"/>         
                </StackPanel>
            </Grid>

            <!-- ════════ RIGHT PANEL: Current Cart ════════ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Section header -->
                <Border Grid.Row="0"
                        Background="#2B8BEB"
                        CornerRadius="8"
                        Padding="12 8"
                        Margin="0 0 0 8">
                    <TextBlock Text="🛒  Current Cart"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"/>
                </Border>

                <!-- Cart list bound to Cart collection -->
                <ListView Grid.Row="1"
                          ItemsSource="{Binding Cart}"
                          SelectedItem="{Binding SelectedCartItem}"
                          BorderBrush="#85C7E8"
                          BorderThickness="1"
                          Margin="0 0 0 8">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Product"    DisplayMemberBinding="{Binding Product.Name}"  Width="120"/>
                            <GridViewColumn Header="Qty"        DisplayMemberBinding="{Binding Quantity}"      Width="45"/>
                            <GridViewColumn Header="Unit Price" DisplayMemberBinding="{Binding Product.Price,  StringFormat={}{0:F2} EGP}" Width="90"/>
                            <GridViewColumn Header="Total"      DisplayMemberBinding="{Binding TotalPrice,     StringFormat={}{0:F2} EGP}" Width="90"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Remove selected cart item -->
                <Button Grid.Row="2"
                        Content="✖  Remove Item"
                        Style="{StaticResource BlueButton}"
                        Background="#4A90D9"
                        Command="{Binding RemoveFromCartCommand}"
                        HorizontalAlignment="Right"
                        Margin="0 0 0 12"/>

                <!-- Totals panel: Subtotal, VAT, Total -->
                <Border Grid.Row="3"
                        Background="#EAF4FB"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0 0 0 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal"   Foreground="#1A3A4A" FontSize="13" Margin="0 3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Subtotal, StringFormat={}{0:F2} EGP}" Foreground="#1A3A4A" FontSize="13"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="VAT (14%)" Foreground="#1A3A4A" FontSize="13" Margin="0 3"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VAT,      StringFormat={}{0:F2} EGP}" Foreground="#1A3A4A" FontSize="13"/>

                        <Rectangle Grid.Row="2" Grid.ColumnSpan="2" Fill="#85C7E8" Height="1" Margin="0 0 0 4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Total" FontSize="16" FontWeight="Bold" Foreground="#2B8BEB"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Total, StringFormat={}{0:F2} EGP}" FontSize="16" FontWeight="Bold" Foreground="#2B8BEB"/>
                    </Grid>
                </Border>

                <!-- Checkout button fires CheckoutCommand -->
                <Button Grid.Row="4"
                        Content="✔  Checkout"
                        Style="{StaticResource BlueButton}"
                        Background="#155A9E"
                        Command="{Binding CheckoutCommand}"
                        HorizontalAlignment="Stretch"
                        Height="46"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
