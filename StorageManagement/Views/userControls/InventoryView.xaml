<UserControl x:Class="StorageManagement.Views.userControls.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StorageManagement.ViewModels"
             FontFamily="Segoe UI">

    <UserControl.DataContext>
        <local:InventoryViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>

        <!-- Low Stock Row Style -->
        <Style x:Key="LowStockRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Button Style -->
        <Style x:Key="BlueButton" TargetType="Button">
            <Setter Property="FontFamily"             Value="Segoe UI"/>
            <Setter Property="FontSize"               Value="13"/>
            <Setter Property="Foreground"             Value="White"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="Padding"                Value="0,8"/>
            <Setter Property="Cursor"                 Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="BorderBrush"     Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Header Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"   Value="#1D4ED8"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Padding"      Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- DataGrid Cell Style -->
        <Style TargetType="DataGridCell">
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BFDBFE"/>
                    <Setter Property="Foreground" Value="#1E3A8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- Main Background -->
    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#1D4ED8" CornerRadius="12"
                Padding="20,14" Margin="0,0,0,16">
            <TextBlock Text="📦  Inventory Management"
                       FontSize="20" FontWeight="Bold"
                       FontFamily="Segoe UI"
                       Foreground="White"/>
        </Border>

        <!-- Search Bar -->
        <Border Grid.Row="1" Background="#EFF6FF" CornerRadius="10"
                Padding="12,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍  Search:"
                           FontFamily="Segoe UI" FontSize="13"
                           Foreground="#1D4ED8" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Width="280"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RoundedTextBox}"/>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" CornerRadius="12" BorderBrush="#BFDBFE"
                BorderThickness="1.5" Margin="0,0,0,14"
                ClipToBounds="True">
            <DataGrid ItemsSource="{Binding FilteredProducts}"
                      SelectedItem="{Binding SelectedProduct}"
                      RowStyle="{StaticResource LowStockRow}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E0EAFF"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="38">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"       Binding="{Binding Id}"                        Width="55"/>
                    <DataGridTextColumn Header="Name"     Binding="{Binding Name}"                      Width="*"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}"                  Width="130"/>
                    <DataGridTextColumn Header="Price"    Binding="{Binding Price, StringFormat=C}"     Width="100"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}"                  Width="90"/>
                    <DataGridTextColumn Header="Status"   Binding="{Binding StatusText}"                Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Form -->
        <Border Grid.Row="3" Background="#EFF6FF" CornerRadius="12"
                Padding="16" BorderBrush="#BFDBFE" BorderThickness="1.5">
            <StackPanel>

                <!-- Form Title -->
                <Border Background="#2563EB" CornerRadius="8"
                        Padding="10,6" Margin="0,0,0,12"
                        HorizontalAlignment="Left">
                    <TextBlock Text="Product Details"
                               FontFamily="Segoe UI" FontSize="13"
                               FontWeight="SemiBold" Foreground="White"/>
                </Border>

                <!-- Fields Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Text="Name"
                               FontFamily="Segoe UI" FontSize="12"
                               Foreground="#1D4ED8" FontWeight="SemiBold"
                               Margin="2,0,8,4"/>
                    <TextBlock Grid.Column="1" Text="Category"
                               FontFamily="Segoe UI" FontSize="12"
                               Foreground="#1D4ED8" FontWeight="SemiBold"
                               Margin="2,0,8,4"/>
                    <TextBlock Grid.Column="2" Text="Price"
                               FontFamily="Segoe UI" FontSize="12"
                               Foreground="#1D4ED8" FontWeight="SemiBold"
                               Margin="2,0,8,4"/>
                    <TextBlock Grid.Column="3" Text="Quantity"
                               FontFamily="Segoe UI" FontSize="12"
                               Foreground="#1D4ED8" FontWeight="SemiBold"
                               Margin="2,0,0,4"/>

                    <TextBox Grid.Row="1" Grid.Column="0"
                             Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource RoundedTextBox}"
                             Margin="0,0,8,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding ProductCategory, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource RoundedTextBox}"
                             Margin="0,0,8,0"/>
                    <TextBox Grid.Row="1" Grid.Column="2"
                             Text="{Binding ProductPrice, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource RoundedTextBox}"
                             Margin="0,0,8,0"/>
                    <TextBox Grid.Row="1" Grid.Column="3"
                             Text="{Binding ProductQuantity, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource RoundedTextBox}"/>
                </Grid>

                <!-- Buttons Row -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button Content="＋  Add"
                            Command="{Binding AddProductCommand}"
                            Style="{StaticResource BlueButton}"
                            Background="#16A34A"
                            Width="90" Margin="0,0,8,0"/>
                    <Button Content="✎  Update"
                            Command="{Binding UpdateProductCommand}"
                            Style="{StaticResource BlueButton}"
                            Background="#2563EB"
                            Width="90" Margin="0,0,8,0"/>
                    <Button Content="🗑  Delete"
                            Command="{Binding DeleteProductCommand}"
                            Style="{StaticResource BlueButton}"
                            Background="#DC2626"
                            Width="90" Margin="0,0,8,0"/>
                    <Button Content="✕  Clear"
                            Command="{Binding ClearFormCommand}"
                            Style="{StaticResource BlueButton}"
                            Background="#64748B"
                            Width="90"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>